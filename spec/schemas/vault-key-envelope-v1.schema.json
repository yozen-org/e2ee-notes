{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yozen.org/e2ee-notes/vault-key-envelope-v1.schema.json",
  "title": "E2EE Notes vault-key envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "suite", "recipientKeyID", "ephemeralPublicKey", "sealedKey"],
  "properties": {
    "version": { "const": 1 },
    "suite": { "const": "P256-HKDF-SHA256-AES256GCM" },
    "recipientKeyID": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ephemeralPublicKey": { "type": "string", "contentEncoding": "base64" },
    "sealedKey": { "type": "string", "contentEncoding": "base64" }
  }
}
